# CoolBlock Backend — Environment Variables
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.

# ─── Application ──────────────────────────────────────────────────────────────
# Set to "development" locally or "production" when deployed.
APP_ENV=development

# Port for the server (used by deployment platforms like Heroku/Render/AWS)
# PORT=8000

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash).
# Add your Vite dev server ports here, and your deployed frontend URL.
# DO NOT use '*' wildcard for production with credentials.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# ─── Database ─────────────────────────────────────────────────────────────────
# CoolBlock uses a local SQLite database file by default.
# WARNING: In ephemeral cloud deployments (e.g. standard Heroku/Render web dynos,
# AWS AppRunner, Docker containers without mounted volumes), a local SQLite file
# will NOT persist across restarts or deployments. 
# For true durable production persistence, you must provision a PostgreSQL database
# and supply its connection string here:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./coolblock.db
